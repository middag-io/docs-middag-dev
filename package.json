{
  "name": "docs-middag-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MIDDAG developer documentation hub (docs.middag.dev), built with the Nimbus preset.",
  "scripts": {
    "docs:prebuild": "node scripts/fetch-injected-docs.mjs",
    "docs:build": "node scripts/build-site.mjs",
    "docs:build:nofetch": "node scripts/build-site.mjs --no-fetch",
    "docs:preview": "middag-docs preview",
    "docs:available": "node scripts/list-available.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:build:nofetch": "node scripts/build-site.mjs --no-fetch",
    "site:preview": "middag-docs preview",
    "test": "node --test 'test/**/*.test.mjs'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@middag-io/docs-proxy-client": "^0.6.0"
  },
  "devDependencies": {
    "@middag-io/nimbus-preset": "^1.5.0",
    "prettier": "^3.8.3",
    "yaml": "^2.9.1"
  }
}
