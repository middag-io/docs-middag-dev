# Copy to .env and fill in. .env is gitignored.

# Bearer token for the PRIVATE docs proxy deployment (Cloudflare Access service
# token). Leave unset to use the public proxy. Read by scripts/fetch-injected-docs.mjs
# from the environment — export it, or run the script with `node --env-file=.env`.
DOCS_PROXY_TOKEN=

# Optional: override the proxy host (defaults to https://docs-proxy.middag.dev).
# DOCS_PROXY_BASE_URL=https://docs-proxy.middag.dev

# NOTE: the GitHub Packages install token for the @middag-io scope (referenced by
# .npmrc as ${NODE_AUTH_TOKEN}) must be exported in your shell BEFORE `npm install`
# — npm does not read .env. A GitHub PAT with `read:packages` scope:
#   export NODE_AUTH_TOKEN=ghp_xxx
