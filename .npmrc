; MIDDAG GitHub Packages — the @middag-io scope resolves to GitHub's npm registry.
; The auth token is read from the environment at install time
; (export NODE_AUTH_TOKEN=<github PAT with read:packages>); never commit a literal token.
@middag-io:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
